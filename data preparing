import numpy as np
from scipy.stats import pearsonr, chi2_contingency

#Pearson korelasyon katsayısını hesaplama:
x = np.array([5,6,7,8,9])
y = np.array([1,3,5,7,7])
corr, p_value = pearsonr(x,y)
print(f'Korelasyon: {corr:.3f}, p-değeri: {p_value:.3f}')

#Ki-Kare testi:
observed = np.array([[10,20,30], [3,8,13]])
chi2, p, dof, expected = chi2_contingency(observed)
print(f'Ki-Kare: {chi2:.3f}, p-değeri: {p:.3f}')

from mlxtend.feature_selection import SequentialFeatureSelector as SFS
from sklearn.ensemble import RandomForestClassifier
from sklearn.datasets import load_iris
from sklearn.model_selection import train_test_split

# Veri hazırlama
X, y = load_iris(return_X_y=True)
X_train, X_test, y_train, y_test = train_test_split(X, y, test_size=0.3)

# İleri seçim algoritması
sfs = SFS(RandomForestClassifier(n_estimators=100),
          k_features=2,
          forward=True,
          floating=False,
          scoring='accuracy',
          cv=5)

sfs.fit(X_train, y_train)
print('Seçilen özellikler:', sfs.k_feature_names_)
print('Doğruluk skoru:', sfs.k_score_)

from sklearn.linear_model import Lasso
from sklearn.ensemble import RandomForestClassifier
import numpy as np

# Lasso ile özellik seçimi
lasso = Lasso(alpha=0.1)
lasso.fit(X_train, y_train)
importance = np.abs(lasso.coef_)
selected_features = np.where(importance > 0.01)[0]

# Random Forest özellik önemleri
rf = RandomForestClassifier(n_estimators=100, random_state=42)
rf.fit(X_train, y_train)
feature_importance = rf.feature_importances_
top_features = np.argsort(feature_importance)[-5:]
print('En önemli 5 özellik indeksleri:', top_features)

from sklearn.decomposition import PCA
from sklearn.preprocessing import StandardScaler
import matplotlib.pyplot as plt

# Veriyi standartlaştırma
scaler = StandardScaler()
X_scaled = scaler.fit_transform(X)

# PCA uygulama
pca = PCA(n_components=2)
X_pca = pca.fit_transform(X_scaled)

print('Açıklanan varyans oranı:', pca.explained_variance_ratio_)
print('Toplam açıklanan varyans:', sum(pca.explained_variance_ratio_))

# Görselleştirme
plt.scatter(X_pca[:, 0], X_pca[:, 1], c=y, cmap='viridis')
plt.xlabel('Birinci Temel Bileşen')
plt.ylabel('İkinci Temel Bileşen')
plt.title('PCA Projeksiyonu')
plt.colorbar()
plt.show()
