for f in features:
        # 1. Değeri sözlükte ara, bulamazsan 'None' dönsün (varsayılan 0'ı kaldır)
        p = cond_probs[c][f].get(test[f]) 
        
        if p is None:
            # 2. EĞER DEĞER BULUNAMADIYSA (eğitimde görülmemişse):
            # 'count=0' için Laplace olasılığını elle hesapla
            V = len(feature_values[f])
            p = (0 + alpha) / (class_counts[c] + alpha * V)
            
        # 3. Artık 'p' hiçbir zaman 0 olamaz, logaritmayı güvenle alabilirsin
        score += math.log(p)
scores[c] = score

print("\nLog-Skor")
for c, score in scores.items():
    print(f"Class {c}: {score:.4f}")

predicted = max(scores.items(), key=lambda x: x[1])[0]
print(f"\nPredicted class:", predicted)
